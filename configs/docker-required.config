# Options reported missing from the stock RT7 kernel by Moby's pinned
# contrib/check-config.sh. Existing enabled dependencies are omitted.

CONFIG_IPC_NS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_POSIX_MQUEUE=y

CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# NETFILTER_XT_MATCH_IPVS depends on IPVS. Enable the small set required for
# Docker's service/load-balancing rules rather than only forcing the matcher.
CONFIG_IP_VS=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
