# Hardware support intentionally reduced where the public source drop omits
# drivers named by the RT7 stock configuration. Keep only sensor directories
# actually present in the pinned source tree so the kernel remains buildable.

CONFIG_CUSTOM_KERNEL_IMGSENSOR="imx350_mipi_raw gc5035_mipi_raw"

# The public tree contains two ST21NFC implementations. The running RT7 exposes
# the power_stats attribute provided by drivers/nfc/st21nfc-i2c, not the older
# drivers/misc/mediatek/nfc copy; enabling both produces duplicate symbols.
# CONFIG_NFC_CHIP_SUPPORT is not set
