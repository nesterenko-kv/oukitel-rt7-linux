# Useful Docker, rootless-container, and container-networking features that are
# present in the selected 4.19.191 source tree but disabled in the stock config.

CONFIG_USER_NS=y
CONFIG_CGROUP_PIDS=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CGROUP_PERF=y
CONFIG_HUGETLBFS=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CFS_BANDWIDTH=y

CONFIG_FHANDLE=y
CONFIG_CHECKPOINT_RESTORE=y

CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_VXLAN=y
CONFIG_IPVLAN=y
CONFIG_MACVLAN=y

# Debian defaults increasingly use the nftables userspace. Keep legacy
# iptables support from the stock config and add the nftables path alongside it.
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
